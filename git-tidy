#!/usr/bin/env bash
# git-tidy — clean up redundant branches and worktrees, and pack objects, in
# the current repo.
#
# Default: non-interactive. Use -i to prompt before each destructive action.

set -euo pipefail

VERSION="1.3.0"

print_usage() {
  cat <<'EOF'
git-tidy — return a repository to a clean baseline: delete branches,
worktrees, and leftover folders whose work the default branch already
contains, then sync the checkout to a fresh default branch.

Usage: git tidy [-i|--interactive] [--offline] [DIR]

Without DIR: tidies the current git repository.
With DIR:    tidies every repository under DIR. Hidden directories are
             not searched, leaving vendored checkouts and tool caches
             alone.

Each run: git fetch --all --prune and git worktree prune; remove
detached folders left under .worktree[s]/; delete redundant branches on
origin (only ones a local branch tracks, by default), then redundant
local branches and their worktrees; when nothing is in progress, switch
to the default branch and ff-only pull; git gc.

A branch is redundant when deleting it loses nothing: every change it
carries is already on origin/<default-branch> — merged, squash- or
rebase-merged (detected by content; needs git >= 2.38), or vouched for
by a merged GitHub PR matching its tip exactly (needs the gh CLI and a
github.com origin). Everything else is left alone: branches with
unmerged work (reported when their upstream is gone), worktrees with
uncommitted changes, and folders holding unsaved files.

Options:
  -i, --interactive   Ask y/N before each destructive action.
      --offline       Skip the network: no fetch, no remote deletions,
                      no pull. Local cleanup runs against the
                      last-fetched state.
  -V, --version       Print version and exit.
      --self-upgrade  Fetch the latest version (brew upgrade for
                      Homebrew installs; the installer otherwise).
  -h, --help          Show this help.

Configuration (git config, per repo or --global; details in the README):
  tidy.remote.branches        delete (default) | keep | prompt
  tidy.remote.branchScope     tracked (default) | all
  tidy.local.branches         delete (default) | keep | prompt
  tidy.local.worktrees        delete (default) | keep | prompt
  tidy.local.detachedFolders  delete (default) | keep | prompt
  tidy.local.worktreeDirs     .worktree:.worktrees:worktrees (default)

  e.g.  git config --global tidy.local.worktrees prompt
        git config --get-regexp '^tidy\.'   # current configuration
EOF
}

interactive=0
offline=0
target_dir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--interactive) interactive=1; shift ;;
    --offline) offline=1; shift ;;
    -V|--version)
      echo "git-tidy $VERSION"
      exit 0
      ;;
    --self-upgrade)
      # A Homebrew-managed copy upgrades through brew: re-running the curl
      # installer would leave a second install in ~/.local/bin, shadowing
      # or shadowed by this one depending on PATH order. Detect brew by
      # resolving the running script's own path into the Cellar.
      self="${BASH_SOURCE[0]}"
      # Follow file symlinks (hop-capped: a symlink cycle must not hang
      # the flag), then canonicalize the directory — brew's opt/ path
      # symlinks the directory rather than the file, so following file
      # symlinks alone would miss it.
      hops=0
      while [[ -L "$self" ]] && (( hops < 40 )); do
        link="$(readlink "$self")"
        [[ "$link" == /* ]] || link="$(dirname "$self")/$link"
        self="$link"
        hops=$((hops + 1))
      done
      if self_dir="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)"; then
        self="$self_dir/$(basename "$self")"
      fi
      if [[ "$self" == */Cellar/git-tidy/* ]]; then
        if command -v brew >/dev/null 2>&1; then
          echo "git-tidy: Homebrew install detected"
          # brew upgrade consults the tap's local clone, and brew's
          # auto-update is throttled — a release published minutes ago
          # is invisible until something refreshes the tap. Pull just
          # the owning tap; best-effort, so an offline upgrade still
          # does whatever cached state allows. The grep tolerates both
          # of brew's JSON shapes: pretty-printed ("tap": "x/y") from
          # real brew, compact from --json consumers.
          tap="$(brew info --json=v2 git-tidy 2>/dev/null \
                   | grep -o '"tap": *"[^"]*"' | head -1 | cut -d'"' -f4 || true)"
          if [[ -n "$tap" ]] && tap_repo="$(brew --repository "$tap" 2>/dev/null)" \
             && [[ -d "$tap_repo" ]]; then
            echo "git-tidy: refreshing $tap..."
            git -C "$tap_repo" pull --ff-only --quiet 2>/dev/null || true
          fi
          echo "git-tidy: running brew upgrade git-tidy..."
          exec brew upgrade git-tidy
        fi
        echo "git-tidy: this copy is Homebrew-managed but brew is not on PATH; upgrade with: brew upgrade git-tidy" >&2
        exit 1
      fi
      echo "git-tidy: fetching latest installer..."
      exec bash -c "$(curl -fsSL https://raw.githubusercontent.com/dbaggott/git-tidy/main/install.sh)"
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    -*)
      echo "git-tidy: unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ -n "$target_dir" ]]; then
        echo "git-tidy: extra argument: $1" >&2
        exit 2
      fi
      target_dir="$1"
      shift
      ;;
  esac
done

# Recursive mode: tidy every repo under target_dir.
if [[ -n "$target_dir" ]]; then
  if [[ ! -d "$target_dir" ]]; then
    echo "git-tidy: not a directory: $target_dir" >&2
    exit 1
  fi
  pass_args=()
  (( interactive )) && pass_args+=(-i)
  (( offline )) && pass_args+=(--offline)
  status=0
  while IFS= read -r gitdir; do
    repo="${gitdir%/.git}"
    echo "### $repo"
    if ! ( cd "$repo" && "${BASH_SOURCE[0]}" ${pass_args[@]+"${pass_args[@]}"} ); then
      echo "### failed: $repo"
      status=1
    fi
    echo
  done < <(find "$target_dir" -mindepth 1 -type d -name '.?*' ! -name .git -prune \
             -o -type d -name .git -prune -print 2>/dev/null | sort)
  exit "$status"
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "git-tidy: not inside a git repository" >&2
  echo >&2
  print_usage >&2
  exit 1
fi

# Resolve a tidy.* decision key to delete | keep | prompt. Unset means
# delete; invalid values warn and fall back to delete. -i upgrades delete
# to prompt (keep stays keep: it is an explicit opt-out, and prompting
# would undo it).
decision_for() {
  local key="$1" value
  value="$(git config --get "$key" 2>/dev/null || true)"
  case "$value" in
    "") value="delete" ;;
    delete|keep|prompt) ;;
    *)
      echo "git-tidy: ignoring invalid $key '$value' (expected delete, keep, or prompt)" >&2
      value="delete"
      ;;
  esac
  if (( interactive )) && [[ "$value" == "delete" ]]; then
    value="prompt"
  fi
  echo "$value"
}

# Whether to act on decision $1 (delete | keep | prompt); $2 is the
# question to ask in prompt mode. 0 = act, 1 = leave as-is.
should_act() {
  case "$1" in
    keep) return 1 ;;
    prompt)
      local answer
      read -r -p "$2 [y/N] " answer </dev/tty
      [[ "$answer" =~ ^[Yy]$ ]]
      ;;
    *) return 0 ;;
  esac
}

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

# A failed fetch (offline, a dead remote among several) must not abort
# the run: tidying against the last-fetched state is safe. Staleness
# only under-detects redundancy — work contained in an old tip is still
# contained in every newer one, as long as the default branch moves
# forward (a force-push after the last fetch reopens the ordinary
# fetch-to-judge race; the commits stay recoverable from the odb until
# gc expiry) — and remote deletion is lease-protected against the stale
# OID, so a branch that moved since rejects.
origin_ok=0
if (( offline )); then
  echo "==> skip fetch (--offline)"
else
  echo "==> git fetch --all --prune"
  fetch_ok=1
  if ! git fetch --all --prune; then
    fetch_ok=0
    echo "  fetch failed (continuing with the already-fetched state)"
  fi

  # fetch --all fails when ANY remote fails; origin itself may be fine,
  # and everything below that needs the network needs only origin.
  origin_ok="$fetch_ok"
  if (( ! fetch_ok )) && git config --get remote.origin.url >/dev/null 2>&1; then
    if git fetch origin --prune >/dev/null 2>&1; then
      origin_ok=1
    fi
  fi

  # Old clones often lack refs/remotes/origin/HEAD, and the local-branch
  # fallback below only guesses main/master — a repo whose default branch
  # is named anything else silently loses most of tidy. Repair the ref
  # while origin is known reachable. (git >= 2.45 fetch maintains the ref
  # itself, making this a no-op there; this covers older git.)
  if (( origin_ok )) && git config --get remote.origin.url >/dev/null 2>&1 \
     && ! git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null 2>&1; then
    if git remote set-head origin -a >/dev/null 2>&1; then
      echo "  repaired origin/HEAD (was unset)"
    fi
  fi
fi

default_branch=""
if ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"; then
  default_branch="${ref#refs/remotes/origin/}"
fi
if [[ -z "$default_branch" ]]; then
  for candidate in main master; do
    if git show-ref --verify --quiet "refs/heads/$candidate"; then
      default_branch="$candidate"
      break
    fi
  done
fi

echo "==> git worktree prune"
git worktree prune

# Print the canonical path of directory "$1" (symlinks resolved).
canonical_dir() {
  (cd "$1" 2>/dev/null && pwd -P)
}

cwd_canon="$(pwd -P)"

# The main checkout's directory, when the repo uses a plain .git folder.
main_repo_dir=""
git_common_dir="$(git rev-parse --git-common-dir)"
if [[ -d "$git_common_dir" ]]; then
  git_common_dir="$(cd "$git_common_dir" && pwd -P)"
fi
if [[ "$git_common_dir" == */.git ]]; then
  main_repo_dir="${git_common_dir%/.git}"
fi

# --- detached worktree folders ---------------------------------------------
# When worktrees live in .worktree/ or .worktrees/ inside the main repo
# folder, a removal can leave the directory behind after git has dropped its
# admin record (e.g. `worktree prune` after the gitdir went missing). Such
# folders are invisible to `git worktree list` and block reusing the path.
# Remove them when they contain no unsaved work; report them otherwise.

# Print the first file under "$1" whose content is not in the repo's object
# database — evidence of work that was never committed or staged. Prints
# nothing when all content is saved. The worktree's .git pointer is skipped;
# anything unreadable or unhashable counts as unsaved. If find cannot fully
# traverse the folder, prints "$1" itself so the caller fails safe.
first_unsaved_file() {
  local dir="$1" listing file hash
  if ! listing="$(find "$dir" -name .git -prune -o \( -type f -o -type l \) -print 2>/dev/null)"; then
    echo "$dir"
    return 0
  fi
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if [[ -L "$file" ]]; then
      hash="$(printf '%s' "$(readlink "$file")" | git hash-object --stdin 2>/dev/null)" || hash=""
    else
      hash="$(git hash-object -- "$file" 2>/dev/null)" || hash=""
    fi
    if [[ -z "$hash" ]] || ! git cat-file -e "$hash" 2>/dev/null; then
      echo "$file"
      return 0
    fi
  done <<<"$listing"
}

detached_decision="$(decision_for tidy.local.detachedFolders)"

# Where worktree folders live: a colon-separated list of directories whose
# immediate children are candidates. Relative entries resolve against the
# main checkout; a configured value replaces the default.
worktree_dirs="$(git config --get tidy.local.worktreeDirs 2>/dev/null || true)"
if [[ -z "$worktree_dirs" ]]; then
  worktree_dirs=".worktree:.worktrees:worktrees"
fi

detached_dirs=()
if [[ -n "$main_repo_dir" ]]; then
  registered_worktrees=()
  while IFS= read -r line; do
    if [[ "$line" == "worktree "* ]]; then
      wt_canon="$(canonical_dir "${line#worktree }")" && registered_worktrees+=("$wt_canon")
    fi
  done < <(git worktree list --porcelain)

  IFS=':' read -r -a worktree_bases <<<"$worktree_dirs"
  for base in ${worktree_bases[@]+"${worktree_bases[@]}"}; do
    [[ -n "$base" ]] || continue
    # git config returns ~ literally; honor it rather than silently
    # resolving it as a relative path. (The quoted tilde is deliberate:
    # we are matching the literal character.)
    # shellcheck disable=SC2088
    if [[ "$base" == "~" || "$base" == "~/"* ]]; then
      base="$HOME${base#\~}"
    fi
    if [[ "$base" != /* ]]; then
      base="$main_repo_dir/$base"
    fi
    [[ -d "$base" ]] || continue
    for dir in "$base"/*/; do
      dir="${dir%/}"
      [[ -d "$dir" ]] || continue
      canon="$(canonical_dir "$dir")" || continue
      registered=0
      for wt in ${registered_worktrees[@]+"${registered_worktrees[@]}"}; do
        # A registered path nested deeper inside the candidate also makes
        # it off-limits: removing the candidate would destroy that worktree.
        if [[ "$wt" == "$canon" || "$wt" == "$canon"/* ]]; then
          registered=1
          break
        fi
      done
      if (( registered )); then
        continue
      fi
      # A folder holding tracked files is part of the project, not a
      # worktree leftover — its content being in the odb (it is
      # committed) must not make it a candidate.
      if [[ -n "$(git -C "$main_repo_dir" ls-files -- ":(literal)$canon" 2>/dev/null | head -1)" ]]; then
        continue
      fi
      detached_dirs+=("$dir")
    done
  done
fi

if (( ${#detached_dirs[@]} > 0 )); then
  if [[ "$detached_decision" == "keep" ]]; then
    # keep is observable but quiet: one summary line — plus reports for
    # folders holding unsaved work, which are invisible to git and easy
    # to lose, so they are flagged whatever the configuration.
    echo "==> keeping ${#detached_dirs[@]} detached worktree folder(s) (tidy.local.detachedFolders keep)"
    for dir in "${detached_dirs[@]}"; do
      unsaved="$(first_unsaved_file "$dir")"
      if [[ "$unsaved" == "$dir" ]]; then
        echo "  keep $dir (not fully readable)"
      elif [[ -n "$unsaved" ]]; then
        echo "  keep $dir (unsaved work, e.g. ${unsaved#"$dir"/})"
      fi
    done
  else
    echo "==> cleaning ${#detached_dirs[@]} detached worktree folder(s)"
    for dir in "${detached_dirs[@]}"; do
      unsaved="$(first_unsaved_file "$dir")"
      if [[ "$unsaved" == "$dir" ]]; then
        echo "  skip $dir (not fully readable)"
        continue
      fi
      if [[ -n "$unsaved" ]]; then
        echo "  skip $dir (unsaved work, e.g. ${unsaved#"$dir"/})"
        continue
      fi
      if ! should_act "$detached_decision" "  remove detached folder $dir?"; then
        echo "  skip $dir"
        continue
      fi
      if err="$(rm -rf -- "$dir" 2>&1)"; then
        echo "  removed $dir"
      else
        echo "  skip $dir (rm failed: $err)"
      fi
    done
  fi
fi

# --- redundant-branch detection -----------------------------------------------
# The ref redundant work is measured against: the default branch as origin
# has it, falling back to the local default branch for remote-less repos.
merge_target=""
if [[ -n "$default_branch" ]]; then
  if git show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
    merge_target="refs/remotes/origin/$default_branch"
  elif git show-ref --verify --quiet "refs/heads/$default_branch"; then
    merge_target="refs/heads/$default_branch"
  fi
fi

# git >= 2.38 can detect squash- and rebase-merged branches by asking
# merge-tree whether merging them would change anything. Probe support with
# a self-merge; older git falls back to ancestry-only detection.
have_merge_tree=0
merge_target_tree=""
if [[ -n "$merge_target" ]]; then
  if git merge-tree --write-tree "$merge_target" "$merge_target" >/dev/null 2>&1; then
    have_merge_tree=1
  fi
  merge_target_tree="$(git rev-parse "$merge_target^{tree}")"
fi

# --- GitHub PR lookup --------------------------------------------------------
# When the content probe hits a merge conflict, pure git cannot tell a
# stale squash-merged branch from live conflicting work. A merged PR whose
# head matches the branch tip exactly settles it, asked through whichever
# supported hosting-provider CLI matches the origin host (currently gh
# for github.com). Installing and authenticating the CLI is the opt-in;
# without one the gate stays closed silently.

github_lookup_state=""  # probed lazily on the first conflict: "yes" / "no"
github_lookup_available() {
  if [[ -z "$github_lookup_state" ]]; then
    github_lookup_state="no"
    if (( ! origin_ok )); then
      return 1
    fi
    local origin_url
    if command -v gh >/dev/null 2>&1; then
      # The raw configured URL: get-url applies url.*.insteadOf
      # rewrites, which can hide the real host.
      origin_url="$(git config --get remote.origin.url 2>/dev/null || true)"
      case "$origin_url" in
        *[/@]github.com[:/]*)
          if gh auth status >/dev/null 2>&1; then
            github_lookup_state="yes"
          fi
          ;;
      esac
    fi
  fi
  [[ "$github_lookup_state" == "yes" ]]
}

# Does a merged GitHub PR account for ref $1's exact tip? On a match, sets
# branch_redundant_via to a citation and returns 0. Memoized per tip OID —
# the same branch gets judged as a remote and as a local candidate.
github_pr_memo=$'\n'
github_merged_pr() {
  local ref="$1" name oid url rest
  github_lookup_available || return 1
  oid="$(git rev-parse "$ref" 2>/dev/null)" || return 1
  if [[ "$github_pr_memo" == *$'\n'"$oid="* ]]; then
    rest="${github_pr_memo#*$'\n'"$oid="}"
    url="${rest%%$'\n'*}"
  else
    name="${ref#refs/remotes/origin/}"
    name="${name#refs/heads/}"
    url="$(gh pr list --head "$name" --state merged --limit 100 \
             --json headRefOid,url \
             --jq "[.[] | select(.headRefOid == \"$oid\") | .url][0] // empty" \
             2>/dev/null || true)"
    github_pr_memo="$github_pr_memo$oid=$url"$'\n'
  fi
  if [[ -n "$url" ]]; then
    branch_redundant_via="merged as $url"
    return 0
  fi
  return 1
}

# Does the default branch already contain all work on ref $1? True when the
# tip is reachable from $merge_target (merged, or never started), or when
# merging it there would leave $merge_target's tree unchanged (squash- or
# rebase-merged). A merge conflict alone means "not redundant" — unless a
# merged GitHub PR vouches for the exact tip (see above), in which case
# branch_redundant_via carries the citation.
branch_redundant() {
  local ref="$1" merged_tree
  branch_redundant_via=""
  if git merge-base --is-ancestor "$ref" "$merge_target" 2>/dev/null; then
    return 0
  fi
  (( have_merge_tree )) || return 1
  if ! merged_tree="$(git merge-tree --write-tree "$merge_target" "$ref" 2>/dev/null)"; then
    github_merged_pr "$ref"
    return $?
  fi
  [[ "$merged_tree" == "$merge_target_tree" ]]
}

# --- redundant remote branches ------------------------------------------------
# Deleting on origin needs origin: skip the section rather than letting
# every push attempt time out against an unreachable remote.
if [[ "$merge_target" == refs/remotes/origin/* ]] && (( ! origin_ok )); then
  echo "==> skip remote branch cleanup (origin not fetched this run)"
elif [[ "$merge_target" == refs/remotes/origin/* ]]; then
  remote_decision="$(decision_for tidy.remote.branches)"

  remote_scope="$(git config --get tidy.remote.branchScope 2>/dev/null || true)"
  case "$remote_scope" in
    "") remote_scope="tracked" ;;
    tracked|all) ;;
    *)
      echo "git-tidy: ignoring invalid tidy.remote.branchScope '$remote_scope' (expected tracked or all)" >&2
      remote_scope="tracked"
      ;;
  esac

  redundant_remote=()
  redundant_remote_via=()
  # Scan even under keep — the summary line below keeps the held-back
  # candidates observable.
  # Upstreams of local branches, newline-delimited for a substring test
  # (no associative arrays so this stays compatible with bash 3.2).
  tracked_upstreams=$'\n'"$(git for-each-ref --format='%(upstream:short)' refs/heads)"$'\n'
  while IFS= read -r remote_ref; do
    name="${remote_ref#refs/remotes/origin/}"
    if [[ "$name" == "HEAD" || "$name" == "$default_branch" ]]; then
      continue
    fi
    if [[ "$remote_scope" == "tracked" && "$tracked_upstreams" != *$'\n'"origin/$name"$'\n'* ]]; then
      continue
    fi
    if ! branch_redundant "$remote_ref"; then
      continue
    fi
    via="$branch_redundant_via"
    # A local branch still building on the remote branch (tracking it,
    # with unmerged work of its own) means its lifecycle isn't over —
    # leave the remote branch alone.
    in_use=0
    while IFS=$'\t' read -r local_name local_upstream; do
      if [[ "$local_upstream" == "origin/$name" ]] && ! branch_redundant "refs/heads/$local_name"; then
        in_use=1
        break
      fi
    done < <(git for-each-ref --format='%(refname:short)%09%(upstream:short)' refs/heads)
    if (( in_use )); then
      continue
    fi
    redundant_remote+=("$name")
    redundant_remote_via+=("$via")
  done < <(git for-each-ref --format='%(refname)' refs/remotes/origin)

  if [[ "$remote_decision" == "keep" ]] && (( ${#redundant_remote[@]} > 0 )); then
    echo "==> keeping ${#redundant_remote[@]} redundant remote branch(es) (tidy.remote.branches keep)"
  elif (( ${#redundant_remote[@]} > 0 )); then
    echo "==> cleaning ${#redundant_remote[@]} redundant remote branch(es)"
    for i in "${!redundant_remote[@]}"; do
      name="${redundant_remote[$i]}"
      via="${redundant_remote_via[$i]}"
      if ! should_act "$remote_decision" "  delete origin/$name?"; then
        echo "  skip origin/$name"
        continue
      fi
      # Lease-protected delete: branch_redundant judged the branch as of
      # our fetch, so refuse if origin has moved since — a push that
      # landed in between must not be destroyed.
      if err="$(git push --force-with-lease="refs/heads/$name:$(git rev-parse "refs/remotes/origin/$name")" \
                  origin ":refs/heads/$name" 2>&1)"; then
        echo "  deleted origin/$name${via:+ ($via)}"
      else
        echo "  skip origin/$name (push failed: ${err//$'\n'/ })"
      fi
    done
  fi
fi

# Print the worktree path for branch "$1" if any worktree has it checked out.
# (A linear porcelain scan; called once per redundant branch. No associative
# arrays so this stays compatible with bash 3.2.)
worktree_for() {
  local target="refs/heads/$1" line cand_path=""
  while IFS= read -r line; do
    if [[ "$line" == "worktree "* ]]; then
      cand_path="${line#worktree }"
    elif [[ "$line" == "branch $target" ]]; then
      echo "$cand_path"
      return 0
    fi
  done < <(git worktree list --porcelain)
}

# Print the per-branch grouping header ($1) before the branch's first
# narrated action; redundant branches that keep gates silently hold back
# never announce.
announce_branch() {
  if (( ! branch_announced )); then
    echo "  $1:"
    branch_announced=1
  fi
}

# --- redundant local branches and their worktrees -------------------------------
local_decision="$(decision_for tidy.local.branches)"
worktree_decision="$(decision_for tidy.local.worktrees)"

if [[ -n "$merge_target" ]]; then
  redundant_local=()
  redundant_local_via=()
  gone_unmerged=()
  while IFS=$'\t' read -r name track; do
    if [[ "$name" == "$default_branch" ]]; then
      continue
    fi
    if branch_redundant "refs/heads/$name"; then
      redundant_local+=("$name")
      redundant_local_via+=("$branch_redundant_via")
    elif [[ "$track" == "[gone]" ]]; then
      # The upstream was deleted (e.g. a PR closed unmerged) but the work
      # is nowhere else — deleting the branch would destroy it.
      gone_unmerged+=("$name")
    fi
  done < <(git for-each-ref --format='%(refname:short)%09%(upstream:track)' refs/heads)

  # keep is leave-as-is without per-item narration: one summary line when
  # candidates are being held back. The gone-but-unmerged report below
  # always prints — it is information about work at risk, not an action.
  if [[ "$local_decision" == "keep" && "$worktree_decision" == "keep" ]]; then
    if (( ${#redundant_local[@]} > 0 )); then
      echo "==> keeping ${#redundant_local[@]} redundant local branch(es) (tidy.local.branches keep)"
    fi
  elif (( ${#redundant_local[@]} == 0 )); then
    echo "==> no redundant local branches"
  else
    echo "==> cleaning ${#redundant_local[@]} redundant local branch(es)"
    # In mixed configurations one decision can be keep while the other
    # acts; count what the keep gates swallow so the header still adds up.
    kept_branches=0
    kept_worktrees=0
    for i in "${!redundant_local[@]}"; do
      branch="${redundant_local[$i]}"
      via="${redundant_local_via[$i]}"
      branch_announced=0
      wt="$(worktree_for "$branch")"
      if [[ -n "$wt" ]]; then
        wt_canon="$(canonical_dir "$wt")" || wt_canon="$wt"
        if [[ -n "$main_repo_dir" && "$wt_canon" == "$main_repo_dir" ]]; then
          # Checked out in the main checkout: switch that to the default
          # branch first. The switch rides on the branch decision since it
          # only exists to let the delete happen. Untracked files don't
          # block the switch — git leaves them alone.
          if [[ "$local_decision" == "keep" ]]; then
            kept_branches=$((kept_branches + 1))
            continue
          fi
          if [[ -n "$(git -C "$wt" status --porcelain -uno)" ]]; then
            announce_branch "$branch"
            echo "    skip (checked out at $wt; tracked files have uncommitted changes)"
            continue
          fi
          announce_branch "$branch"
          if ! should_act "$local_decision" "    switch $wt to $default_branch and delete branch $branch?"; then
            echo "    skip"
            continue
          fi
          if err="$(git -C "$wt" switch --quiet "$default_branch" 2>&1)"; then
            echo "    switched $wt to $default_branch"
            if [[ "$branch" == "$current_branch" ]]; then
              current_branch="$default_branch"
            fi
          else
            echo "    skip (cannot switch to $default_branch: ${err//$'\n'/ })"
            continue
          fi
          if err="$(git branch -D "$branch" 2>&1)"; then
            echo "    deleted branch${via:+ ($via)}"
          else
            echo "    skip (${err//$'\n'/ })"
          fi
          continue
        fi
        # Checked out in a secondary worktree: remove the worktree (its own
        # decision), then the branch. Under keep the branch stays checked
        # out there, so there is nothing further to do for it either.
        if [[ "$worktree_decision" == "keep" ]]; then
          kept_worktrees=$((kept_worktrees + 1))
          continue
        fi
        if [[ "$cwd_canon" == "$wt_canon" || "$cwd_canon" == "$wt_canon"/* ]]; then
          announce_branch "$branch"
          echo "    skip (checked out in current worktree $wt)"
          continue
        fi
        if [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]]; then
          announce_branch "$branch"
          echo "    skip (worktree $wt not clean)"
          continue
        fi
        announce_branch "$branch"
        if ! should_act "$worktree_decision" "    remove worktree $wt (branch $branch)?"; then
          echo "    skip (worktree kept)"
          continue
        fi
        if err="$(git worktree remove "$wt" 2>&1)"; then
          echo "    removed worktree $wt"
        else
          echo "    skip (cannot remove worktree: ${err//$'\n'/ })"
          continue
        fi
      fi

      if [[ "$local_decision" == "keep" ]]; then
        kept_branches=$((kept_branches + 1))
        continue
      fi
      announce_branch "$branch"
      if ! should_act "$local_decision" "    delete branch $branch?"; then
        echo "    skip"
        continue
      fi
      if err="$(git branch -D "$branch" 2>&1)"; then
        echo "    deleted branch${via:+ ($via)}"
      else
        echo "    skip (${err//$'\n'/ })"
      fi
    done
    if (( kept_branches > 0 )); then
      echo "  kept $kept_branches branch(es) (tidy.local.branches keep)"
    fi
    if (( kept_worktrees > 0 )); then
      echo "  kept $kept_worktrees worktree(s) (tidy.local.worktrees keep)"
    fi
  fi

  if (( ${#gone_unmerged[@]} > 0 )); then
    echo "==> keeping ${#gone_unmerged[@]} branch(es) with work not on origin/$default_branch"
    for branch in "${gone_unmerged[@]}"; do
      echo "  keep $branch (upstream gone)"
    done
  fi
fi

# Sync the main checkout to the default branch when nothing is in progress.
if [[ -n "$default_branch" ]]; then
  in_progress_reason=""

  # Other worktrees never block the sync: neither switching this checkout
  # nor a ff-only pull can disturb them. What blocks is work in *this*
  # checkout — uncommitted tracked changes, commits not on the default
  # branch — or the switch being impossible because the default branch is
  # checked out in another worktree. Untracked files don't block (-uno):
  # switch and pull leave them alone, and worktrees kept under
  # .worktree[s]/ always show as untracked.
  #
  # Several blockers can hold at once; report all of them — naming only
  # the first reads as a promise that resolving it would unblock the sync.
  append_reason() {
    if [[ -n "$in_progress_reason" ]]; then
      in_progress_reason="$in_progress_reason; $1"
    else
      in_progress_reason="$1"
    fi
  }
  if [[ -z "$current_branch" ]]; then
    # A detached HEAD was parked there deliberately (a pinned checkout,
    # a tool-managed clone) — switching it to the default branch is not
    # tidying, it is undoing someone's arrangement.
    append_reason "detached HEAD"
  else
    if [[ "$current_branch" != "$default_branch" ]]; then
      default_wt="$(worktree_for "$default_branch")"
      if [[ -n "$default_wt" ]]; then
        append_reason "$default_branch checked out at $default_wt"
      fi
    fi
    if [[ -n "$(git status --porcelain -uno)" ]]; then
      append_reason "tracked files have uncommitted changes"
    fi
    if ahead="$(git rev-list --count "origin/$default_branch..HEAD" 2>/dev/null)"; then
      if [[ "$ahead" != "0" ]]; then
        append_reason "HEAD has $ahead commit(s) not on origin/$default_branch"
      fi
    else
      append_reason "cannot compare HEAD to origin/$default_branch"
    fi
  fi

  if [[ -n "$in_progress_reason" ]]; then
    # Name the parked branch: "HEAD has commits..." without saying where
    # HEAD is sends the user off to find out.
    if [[ -n "$current_branch" && "$current_branch" != "$default_branch" ]]; then
      echo "==> skip sync to $default_branch (on $current_branch: $in_progress_reason)"
    else
      echo "==> skip sync to $default_branch ($in_progress_reason)"
    fi
  else
    # Both steps can fail in normal use now that untracked files don't
    # gate sync (e.g. an untracked file an incoming tracked one would
    # overwrite) — report and carry on so gc still runs.
    if [[ "$current_branch" != "$default_branch" ]]; then
      echo "==> git switch $default_branch"
      if ! err="$(git switch --quiet "$default_branch" 2>&1)"; then
        echo "  skip switch (${err//$'\n'/ })"
      fi
    fi
    if [[ "$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$default_branch" ]]; then
      if (( origin_ok )); then
        echo "==> git pull --ff-only"
        if ! git pull --ff-only; then
          echo "  pull failed; leaving the checkout as-is"
        fi
      else
        echo "==> skip pull (origin not fetched this run)"
      fi
    fi
  fi
fi

echo "==> git gc"
git gc --quiet
echo "==> done"
